#!/bin/bash
# FreeScout tester-env CLI
# IMAGE_TAG set by scripts/rl-env to a content-addressed tag so identical
# (baseline, patch-set) combos share an image. Manual invocations get :dev.
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE_FILE="${SCRIPT_DIR}/docker-compose.yml"
IMAGE_NAME="${IMAGE_TAG:-tester-env-freescout:dev}"
CONTAINER_NAME="${CONTAINER_NAME:-tester-env-freescout}"
PORT="${PORT:-8042}"
COMMAND="${1:-help}"
RUN_ID="default"
if [ "$#" -gt 0 ]; then shift; fi
while [ "$#" -gt 0 ]; do
    case "$1" in
        --run-id) RUN_ID="$2"; shift 2 ;;
        --port) PORT="$2"; shift 2 ;;
        *) echo "Unknown argument: $1" >&2; exit 2 ;;
    esac
done
if [[ ! "$RUN_ID" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]; then
    echo "Invalid run id: $RUN_ID" >&2
    exit 2
fi
# Compute APP_URL from PORT so scenario runtime with --port auto works.
# When scripts/rl-env allocates a random port, APP_URL must match so auth
# redirects, CSP headers, and asset URLs all use the correct port.
APP_URL="${APP_URL:-http://172.17.0.1:${PORT}}"
COMPOSE_PROJECT="tester-env-freescout-${RUN_ID}"
CONTAINER_NAME="tester-env-freescout-${RUN_ID}"
export IMAGE_TAG="${IMAGE_NAME}" CONTAINER_NAME PORT APP_URL

# Credentials
ADMIN_EMAIL="${ADMIN_EMAIL:-admin@tester-env.local}"
ADMIN_PASS="${ADMIN_PASS:-TesterEnv123!}"

usage() {
    cat <<EOF
Usage: $0 {deploy|seed|verify|reset|stop|logs|status|help} [--run-id ID] [--port PORT]

Commands:
  deploy   Build image from source, start containers, initialize app
  seed     Populate deterministic Northwind Outdoor Gear helpdesk data
  verify   Check deterministic seed counts and key rendered pages
  reset    Stop containers, remove volumes, return to clean slate
  stop     Stop containers (preserves data)
  logs     Tail container logs (app + db)
  status   Show whether app is running and on what port
  help     Show this message

Environment:
  IMAGE_TAG       Docker image tag (default: tester-env-freescout:dev)
  CONTAINER_NAME  Container name (default: tester-env-freescout)
  PORT            Host port (default: 8042)
   APP_URL         Application URL for redirects/CSP/assets (default: http://172.17.0.1:${PORT})
  ADMIN_EMAIL     Admin email (default: admin@tester-env.local)
  ADMIN_PASS      Admin password (default: TesterEnv123!)

Credentials:
  URL:      ${APP_URL}
  Email:    ${ADMIN_EMAIL}
  Password: ${ADMIN_PASS}
EOF
}

cmd_deploy() {
    echo "==> Building FreeScout image: ${IMAGE_NAME}"
    IMAGE_TAG="${IMAGE_NAME}" CONTAINER_NAME="${CONTAINER_NAME}" PORT="${PORT}" APP_URL="${APP_URL}" \
        docker compose -f "${COMPOSE_FILE}" -p "${COMPOSE_PROJECT}" build app

    echo "==> Starting FreeScout..."
    IMAGE_TAG="${IMAGE_NAME}" CONTAINER_NAME="${CONTAINER_NAME}" PORT="${PORT}" APP_URL="${APP_URL}" \
        ADMIN_EMAIL="${ADMIN_EMAIL}" ADMIN_PASS="${ADMIN_PASS}" \
        docker compose -f "${COMPOSE_FILE}" -p "${COMPOSE_PROJECT}" up -d

    echo "==> Waiting for FreeScout to be ready (up to 60s)..."
    for i in $(seq 1 60); do
        if curl -s -o /dev/null -w "%{http_code}" "http://localhost:${PORT}/login" 2>/dev/null | grep -q "200\|302"; then
            echo "==> FreeScout ready at http://localhost:${PORT}"
            echo "    Admin: ${ADMIN_EMAIL} / ${ADMIN_PASS}"
            return 0
        fi
        sleep 1
    done
    echo "==> Warning: FreeScout did not respond within 60s. Check logs."
    return 1
}

cmd_reset() {
    echo "==> Stopping FreeScout containers and removing volumes..."
    IMAGE_TAG="${IMAGE_NAME}" CONTAINER_NAME="${CONTAINER_NAME}" PORT="${PORT}" APP_URL="${APP_URL}" \
        docker compose -f "${COMPOSE_FILE}" -p "${COMPOSE_PROJECT}" down -v
    # Apache writes generated assets/cache into the owned source worktree.
    # Restore the invoking user's ownership before rl-env removes that worktree.
    if docker image inspect "${IMAGE_NAME}" >/dev/null 2>&1; then
        docker run --rm --network none --entrypoint sh \
            -v "${SCRIPT_DIR}:/source" "${IMAGE_NAME}" -c '
            for path in /source/bootstrap/cache /source/public/css/builds /source/public/js/builds; do
                if [ -d "$path" ]; then chown -R "$1:$2" "$path"; fi
            done' sh "$(id -u)" "$(id -g)"
    fi
    # Clean .env so next deploy initializes fresh
    rm -f "${SCRIPT_DIR}/.env"
    echo "==> Reset complete. Run '$0 deploy' for a fresh start."
}

cmd_seed() {
    echo "==> Seeding deterministic FreeScout helpdesk data..."
    if ! docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
        echo "==> FreeScout container is not running. Run '$0 deploy' first."
        return 1
    fi

    if [[ "${TESTER_ENV_SCENARIO:-}" == "freescout-search-hash-conversation-number-001" ]]; then
        docker exec "${CONTAINER_NAME}" sh -c '
            sed -i "/^APP_CUSTOM_NUMBER=/d" /var/www/html/.env
            printf "\nAPP_CUSTOM_NUMBER=true\n" >> /var/www/html/.env
            cd /var/www/html && php artisan config:clear --no-interaction'
    fi

    docker exec -i -u www-data -e TESTER_ENV_SCENARIO "${CONTAINER_NAME}" php <<'PHP'
<?php
chdir('/var/www/html');
define('LARAVEL_START', microtime(true));
if (!function_exists('e')) {
    function e($value, $doubleEncode = false) {
        if ($value instanceof Illuminate\Contracts\Support\Htmlable) {
            return $value->toHtml();
        }
        return htmlspecialchars($value ?? '', ENT_QUOTES, 'UTF-8', $doubleEncode);
    }
}
require 'vendor/autoload.php';
$app = require 'bootstrap/app.php';
$kernel = $app->make(Illuminate\Contracts\Console\Kernel::class);
$kernel->bootstrap();
require 'database/seeds/TesterEnvSeeder.php';
try {
    (new TesterEnvSeeder())->run();
    if (getenv('TESTER_ENV_SCENARIO') === 'freescout-bulk-shift-select-range-001') {
        $original = App\Conversation::where('number', 7001)->firstOrFail();
        $originalThread = App\Thread::where('conversation_id', $original->id)
            ->where('type', App\Thread::TYPE_CUSTOMER)->firstOrFail();
        foreach ([
            [7009, 'Confirm rainfly dimensions for the trail expo', 'Please confirm the packed rainfly dimensions before our trail expo setup.'],
            [7010, 'Arrange spare guy lines for the demo booth', 'We need spare guy lines for the Summit Cycles demo booth.'],
        ] as $row) {
            $conversation = $original->replicate();
            $conversation->subject = $row[1];
            $conversation->preview = $row[2];
            $conversation->save();
            DB::table('conversations')->where('id', $conversation->id)->update(['number' => $row[0]]);
            $thread = $originalThread->replicate();
            $thread->conversation_id = $conversation->id;
            $thread->body = '<p>'.$row[2].'</p>';
            $thread->message_id = '<northwind-'.$row[0].'@summit-cycles.example>';
            $thread->save();
        }
        $original->mailbox->updateFoldersCounters();
    }
} catch (Throwable $e) {
    fwrite(fopen('php://stderr', 'w'), $e->getMessage()."\n");
    exit(1);
}
PHP
    echo "==> Seed complete. Northwind helpdesk data and scenario permissions are ready."
}

cmd_verify() {
    echo "==> Verifying deterministic FreeScout seed data..."
    if ! docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
        echo "==> FreeScout container is not running. Run '$0 deploy' first."
        return 1
    fi

    docker exec -i -u www-data -e TESTER_ENV_SCENARIO "${CONTAINER_NAME}" php <<'PHP'
<?php
chdir('/var/www/html');
define('LARAVEL_START', microtime(true));
if (!function_exists('e')) {
    function e($value, $doubleEncode = false) {
        if ($value instanceof Illuminate\Contracts\Support\Htmlable) {
            return $value->toHtml();
        }
        return htmlspecialchars($value ?? '', ENT_QUOTES, 'UTF-8', $doubleEncode);
    }
}
require 'vendor/autoload.php';
$app = require 'bootstrap/app.php';
$kernel = $app->make(Illuminate\Contracts\Console\Kernel::class);
$kernel->bootstrap();

$rangeScenario = getenv('TESTER_ENV_SCENARIO') === 'freescout-bulk-shift-select-range-001';
if (getenv('TESTER_ENV_SCENARIO') === 'freescout-search-hash-conversation-number-001'
    && App\Conversation::numberFieldName() !== 'number') {
    fwrite(fopen('php://stderr', 'w'), "Seed verify failed; custom visible ticket numbering is disabled.\n");
    exit(1);
}
$checks = [
    'mailboxes' => [DB::table('mailboxes')->count(), 3],
    'customers' => [DB::table('customers')->count(), 6],
    'agents' => [DB::table('users')->where('role', App\User::ROLE_USER)->count(), 3],
    'conversations' => [DB::table('conversations')->count(), $rangeScenario ? 10 : 8],
    'active_conversations' => [DB::table('conversations')->where('status', App\Conversation::STATUS_ACTIVE)->count(), $rangeScenario ? 5 : 3],
    'pending_conversations' => [DB::table('conversations')->where('status', App\Conversation::STATUS_PENDING)->count(), 2],
    'closed_conversations' => [DB::table('conversations')->where('status', App\Conversation::STATUS_CLOSED)->count(), 2],
    'spam_conversations' => [DB::table('conversations')->where('status', App\Conversation::STATUS_SPAM)->count(), 1],
];

foreach ($checks as $name => $check) {
    if ($check[0] !== $check[1]) {
        fwrite(fopen('php://stderr', 'w'), "Seed verify failed for {$name}: expected {$check[1]}, got {$check[0]}\n");
        exit(1);
    }
}

$subjects = [
    'Expedite replacement tent poles before Friday',
    'Update billing contact for Harbor Cafe Group',
    'Warranty exchange for RidgeLine GPS beacon',
];
foreach ($subjects as $subject) {
    if (!DB::table('conversations')->where('subject', $subject)->exists()) {
        fwrite(fopen('php://stderr', 'w'), "Seed verify failed; missing conversation subject: {$subject}\n");
        exit(1);
    }
}
if (!DB::table('conversations')->where('number', 7001)->where('subject', 'Expedite replacement tent poles before Friday')->exists()
    || !DB::table('conversations')->where('number', 7002)->where('subject', 'Update billing contact for Harbor Cafe Group')->exists()
    || !DB::table('conversations')->where('number', 7003)->where('subject', 'Freight delay on showroom order NW-1048')->exists()) {
    fwrite(fopen('php://stderr', 'w'), "Seed verify failed; expected fixed visible ticket numbers 7001-7003.\n");
    exit(1);
}

$mia = App\User::where('email', 'mia.chen@tester-env.local')->first();
$noah = App\User::where('email', 'noah.patel@tester-env.local')->first();
$support = App\Mailbox::where('name', 'Northwind Support')->first();
$returns = App\Mailbox::where('name', 'Northwind Returns')->first();
$billing = App\Mailbox::where('name', 'Northwind Billing')->first();
if ($rangeScenario && DB::table('conversations')->where('mailbox_id', $support->id)
    ->where('user_id', $mia->id)->where('status', App\Conversation::STATUS_ACTIVE)->count() !== 3) {
    fwrite(fopen('php://stderr', 'w'), "Seed verify failed; expected three active conversations in the same Assigned folder.\n");
    exit(1);
}
if (!$mia || !$noah || !$support || !$returns || !$billing) {
    fwrite(fopen('php://stderr', 'w'), "Seed verify failed; missing scenario user or mailbox fixtures.\n");
    exit(1);
}
if (!$mia->hasPermission(App\User::PERM_DELETE_CONVERSATIONS) || !$noah->hasPermission(App\User::PERM_DELETE_CONVERSATIONS)) {
    fwrite(fopen('php://stderr', 'w'), "Seed verify failed; expected non-admin delete-conversation permission.\n");
    exit(1);
}
if (!$noah->hasPermission(App\User::PERM_ONLY_ASSIGNED_TICKETS)) {
    fwrite(fopen('php://stderr', 'w'), "Seed verify failed; expected Noah Patel to have assigned-only visibility.\n");
    exit(1);
}
if (!$mia->hasManageMailboxPermission($support->id, App\Mailbox::ACCESS_PERM_SIGNATURE)) {
    fwrite(fopen('php://stderr', 'w'), "Seed verify failed; expected Mia Chen to manage Northwind Support signatures.\n");
    exit(1);
}
if (!DB::table('mailbox_user')->where('mailbox_id', $support->id)->where('user_id', $mia->id)->exists()
    || DB::table('mailbox_user')->where('mailbox_id', $returns->id)->where('user_id', $mia->id)->exists()) {
    fwrite(fopen('php://stderr', 'w'), "Seed verify failed; expected Mia on Support but not Returns.\n");
    exit(1);
}
if (!DB::table('mailbox_user')->where('mailbox_id', $support->id)->where('user_id', $noah->id)->exists()
    || !DB::table('mailbox_user')->where('mailbox_id', $returns->id)->where('user_id', $noah->id)->exists()) {
    fwrite(fopen('php://stderr', 'w'), "Seed verify failed; expected Noah on Support and Returns for assigned-only search fixture.\n");
    exit(1);
}
if (DB::table('conversations')->whereColumn('id', 'number')->exists()) {
    fwrite(fopen('php://stderr', 'w'), "Seed verify failed; expected conversation ids to differ from visible ticket numbers.\n");
    exit(1);
}
$mailboxOrder = DB::table('mailboxes')->orderBy('id')->pluck('name')->toArray();
if ($mailboxOrder !== ['Northwind Support', 'Northwind Billing', 'Northwind Returns']) {
    fwrite(fopen('php://stderr', 'w'), "Seed verify failed; expected non-alphabetical mailbox creation order.\n");
    exit(1);
}
$replacementMatches = DB::table('conversations')
    ->where('subject', 'like', '%replacement%')
    ->pluck('user_id')
    ->toArray();
if (!in_array($mia->id, $replacementMatches) || !in_array($noah->id, $replacementMatches)) {
    fwrite(fopen('php://stderr', 'w'), "Seed verify failed; expected replacement search fixtures assigned to Mia and Noah.\n");
    exit(1);
}

echo "DB seed counts and scenario permissions OK.\n";
PHP

    local cookie token page
    cookie="$(mktemp)"
    page="$(mktemp)"
    curl -fsS -c "${cookie}" "${APP_URL}/login" -o "${page}"
    token="$(sed -n 's/.*name="_token" value="\([^"]*\)".*/\1/p' "${page}")"
    if [ -z "${token}" ]; then
        echo "==> Could not extract CSRF token from login page."
        rm -f "${cookie}" "${page}"
        return 1
    fi
    curl -fsS -b "${cookie}" -c "${cookie}" -X POST "${APP_URL}/login" \
        --data-urlencode "_token=${token}" \
        --data-urlencode "email=${ADMIN_EMAIL}" \
        --data-urlencode "password=${ADMIN_PASS}" \
        -o /dev/null
    curl -fsS -b "${cookie}" "${APP_URL}/mailboxes" -o "${page}"
    for text in "Northwind Support" "Northwind Billing" "Northwind Returns"; do
        if ! grep -q "${text}" "${page}"; then
            echo "==> Rendered mailboxes page missing '${text}'."
            rm -f "${cookie}" "${page}"
            return 1
        fi
    done
    rm -f "${cookie}" "${page}"
    echo "==> Rendered mailbox list includes all seeded mailbox names."
}

cmd_stop() {
    echo "==> Stopping FreeScout containers (preserving data)..."
    IMAGE_TAG="${IMAGE_NAME}" CONTAINER_NAME="${CONTAINER_NAME}" PORT="${PORT}" APP_URL="${APP_URL}" \
        docker compose -f "${COMPOSE_FILE}" -p "${COMPOSE_PROJECT}" stop 2>/dev/null || true
    echo "==> Stopped."
}

cmd_logs() {
    IMAGE_TAG="${IMAGE_NAME}" CONTAINER_NAME="${CONTAINER_NAME}" PORT="${PORT}" APP_URL="${APP_URL}" \
        docker compose -f "${COMPOSE_FILE}" -p "${COMPOSE_PROJECT}" logs --tail=100 -f
}

cmd_status() {
    if docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
        echo "==> FreeScout running at http://localhost:${PORT}"
        echo "    Admin: ${ADMIN_EMAIL} / ${ADMIN_PASS}"
        return 0
    else
        echo "==> FreeScout not running."
        return 1
    fi
}

case "${COMMAND}" in
    deploy)  cmd_deploy ;;
    seed)    cmd_seed ;;
    verify)  cmd_verify ;;
    reset)   cmd_reset ;;
    stop)    cmd_stop ;;
    logs)    cmd_logs ;;
    status)  cmd_status ;;
    help|*)  usage ;;
esac
